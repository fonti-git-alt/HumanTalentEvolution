---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Consultora especializada en valoración del talento humano. Impulsamos el crecimiento de las empresas a través de su talento.', image = '/images/og-image.jpg' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://humantalentevolution.com');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Anti-FOUC: Apply theme before render -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    
    <!-- Primary Meta Tags -->
    <title>{title} | Human Talent Evolution</title>
    <meta name="title" content={`${title} | Human Talent Evolution`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Human Talent Evolution`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | Human Talent Evolution`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Global Styles -->
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    
    <!-- Smooth Scroll Initialization -->
    <script>
      import { initSmoothScroll, prefersReducedMotion } from '../lib/animations';
      
      // Initialize smooth scroll unless user prefers reduced motion
      if (!prefersReducedMotion()) {
        const { destroy } = initSmoothScroll();
        
        // Cleanup on page navigation
        document.addEventListener('astro:before-swap', () => {
          destroy();
        });
      }
    </script>
  </body>
</html>
