---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  class?: string;
}

const { title, subtitle, align = 'center', class: className = '' } = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: '!text-center mx-auto w-full',
  right: 'text-right ml-auto',
};
---

<div class={`max-w-2xl ${alignClasses[align]} ${className}`}>
  <h2 class="section-title mb-4">{title}</h2>
  {subtitle && <p class="section-subtitle">{subtitle}</p>}
  <slot />
</div>
