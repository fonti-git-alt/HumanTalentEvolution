---
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

const tarjetas = [
  {
    title: 'Nos incorporamos al ADN de tu organización',
    description: 'Creando soluciones personalizadas estratégicas que alineen personas, procesos y cultura.',
    image: '/images/reduxfotos/why us/INCORPORAMOS_ADN_DE_TU_ORG.jpg'
  },
  {
    title: 'Innovación y enfoque centrado en el futuro',
    description: 'Proporcionamos ideas innovadoras y creativas para que las compañías se adapten y prosperen en un entorno empresarial de constante evolución.',
    image: '/images/reduxfotos/why us/INNOVACIÓN_Y_ENFOQUE.jpg'
  },
  {
    title: 'Servicio al cliente inigualable y excepcional',
    description: 'Brindamos acompañamiento cercano, entendiendo tus necesidades y brindando soluciones claras y efectivas.',
    image: '/images/reduxfotos/why us/SERVICIO AL CLIENTE.jpeg'
  }
];

---
<section class="py-24 bg-primary-lighter">
  <div class="container-page">
    <SectionTitle
      title="¿Por qué Human Talent Evolution?"
      subtitle="Somos tu socio estratégico en gestión del talento."
      class="text-center"
    />
    
    <!-- Tres tarjetas -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {tarjetas.map((tarjeta) => (
        <div class="flex flex-col bg-white rounded-xl shadow hover:shadow-lg transition-shadow overflow-hidden">
          <!-- Imagen como banner superior -->
          <div class="w-full h-40 md:h-48 flex-shrink-0">
            <img
              src={tarjeta.image}
              alt={tarjeta.title}
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Contenido -->
          <div class="p-4 md:p-6 flex-1 flex flex-col">
            <div class="space-y-2 flex-1">
              <h3 class="text-lg md:text-xl font-heading font-semibold text-text-dark leading-tight">{tarjeta.title}</h3>
              <p class="text-text-medium text-sm leading-relaxed">{tarjeta.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Botón CTA debajo de las tarjetas -->
    <div class="mt-8 md:mt-12 flex justify-center">
      <a 
        href="/contacto"
        class="relative group inline-flex items-center justify-center px-6 py-3 font-semibold leading-6 text-white bg-primary shadow-xl cursor-pointer rounded-xl transition-all duration-300 hover:scale-105 active:scale-95"
      >
        <span
          class="absolute inset-0 rounded-xl bg-gradient-to-r from-accent-gold via-accent-gold to-accent-gold/80 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        ></span>
        <span class="relative z-10 flex items-center gap-2">
          Conócenos
          <svg
            class="w-4 h-4 transition-transform duration-500 group-hover:translate-x-1"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              clip-rule="evenodd"
              d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
              fill-rule="evenodd"
            ></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
