---
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

const soluciones = [
  {
    title: 'Atracción y Selección',
    description: 'Encontramos el talento ideal que tu empresa necesita para crecer.',
    href: '/empresas#atraccion-seleccion',
    icon: '/images/icons/icon-atraccion.png',
  },
  {
    title: 'Desarrollo y Valoración del Talento',
    description: 'Potenciamos el desempeño de tu equipo y llevamos su talento al siguiente nivel.',
    href: '/empresas#desarrollo-talento',
    icon: '/images/icons/icon-desarrollo.png',
  },
  {
    title: 'Formación y Liderazgo',
    description: 'Formamos líderes que inspiran, guían y generan resultados.',
    href: '/empresas#formacion-liderazgo',
    icon: '/images/icons/icon-formacion.png',
  },
  {
    title: 'Bienestar y Cultura Organizacional',
    description: 'Construimos una cultura sólida donde las personas y el negocio prosperen.',
    href: '/empresas#bienestar-cultura',
    icon: '/images/icons/icon-bienestar.png',
  },
  {
    title: 'Salud Psicosocial',
    description: 'Cuidamos el bienestar emocional de tu equipo y fortalecemos tu productividad.',
    href: '/empresas#salud-psicosocial',
    icon: '/images/icons/icon-salud.png',
  },
  // Duplicado del primero para loop infinito
  {
    title: 'Atracción y Selección',
    description: 'Encontramos el talento ideal que tu empresa necesita para crecer.',
    href: '/empresas#atraccion-seleccion',
    icon: '/images/icons/icon-atraccion.png',
  },
];
--- 

<section class="py-24 bg-white" id="soluciones">
  <div class="container-page">
    <SectionTitle 
      title="Soluciones para empresas"
      subtitle="Cada servicio está diseñado para resolver problemas específicos de talento."
      align="center"
    />
    
    <!-- Carrusel de iconos -->
    <div class="relative mt-16 group">
      <!-- Contenedor del carrusel -->
      <div id="soluciones-carousel" class="flex overflow-x-auto scrollbar-hide scroll-smooth snap-x snap-mandatory py-8" style="mask: linear-gradient(to right, transparent 0%, white 10%, white 90%, transparent 100%); -webkit-mask: linear-gradient(to right, transparent 0%, white 10%, white 90%, transparent 100%);" data-num-items="6">
        <div class="flex gap-8 px-4">
          {soluciones.map((solucion, i) => (
            <div class="flex-none w-[280px] snap-start" data-index={i}>
              <a href={solucion.href} class="group/icon block text-center">
                {/* Ícono circular */}
                <div class="relative w-32 h-32 mx-auto mb-6">
                  <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-transparent rounded-full blur-lg opacity-50 group-hover/icon:opacity-70 transition-opacity"></div>
                  <div class="relative w-full h-full rounded-full bg-white border-2 border-gray-100 shadow-lg flex items-center justify-center overflow-hidden group-hover/icon:scale-105 group-hover/icon:border-primary transition-all duration-300">
                    <img 
                      src={solucion.icon} 
                      alt={solucion.title}
                      class="w-16 h-16 object-contain filter grayscale group-hover/icon:grayscale-0 transition-all duration-300"
                    />
                  </div>
                </div>
                
                {/* Título */}
                <h3 class="text-base font-heading font-bold text-text-dark mb-2 group-hover/icon:text-primary transition-colors leading-tight">
                  {solucion.title}
                </h3>
                
                {/* Descripción */}
                <p class="text-text-medium text-sm leading-relaxed px-2">
                  {solucion.description}
                </p>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Botón anterior -->
      <button
        id="soluciones-prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 flex items-center justify-center bg-white rounded-full shadow-lg hover:bg-gray-50 transition-all hover:scale-110 opacity-0 group-hover:opacity-100"
        aria-label="Anterior"
      >
        <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Botón siguiente -->
      <button
        id="soluciones-next"
        class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 flex items-center justify-center bg-white rounded-full shadow-lg hover:bg-gray-50 transition-all hover:scale-110 opacity-0 group-hover:opacity-100"
        aria-label="Siguiente"
      >
        <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>



    <div class="text-center mt-12">
      <Button href="/empresas" variant="secondary">
        Ver todas las soluciones →
      </Button>
    </div>
  </div>
</section>

<script>
  (function() {
    const carousel = document.getElementById('soluciones-carousel');
    const prevBtn = document.getElementById('soluciones-prev');
    const nextBtn = document.getElementById('soluciones-next');

    if (!carousel) return;

    const numItems = parseInt(carousel.dataset.numItems || '5');
    let autoRotateInterval: number | null = null;
    let activeIndex = 0;
    let currentItemWidth = 280;
    let currentGap = 32;



    // Actualizar elemento activo (resaltar el del medio)
    function updateActive() {
      const items = document.querySelectorAll('[data-index]');
      if (!carousel) return;
      const containerRect = carousel.getBoundingClientRect();
      const containerCenter = containerRect.left + containerRect.width / 2;
      let closestIndex = 0;
      let minDistance = Infinity;

      items.forEach((item, index) => {
        const itemRect = item.getBoundingClientRect();
        const itemCenter = itemRect.left + itemRect.width / 2;
        const distance = Math.abs(itemCenter - containerCenter);
        if (distance < minDistance) {
          minDistance = distance;
          closestIndex = index;
        }
      });

      const logicalIndex = closestIndex === 5 ? 0 : closestIndex;

      items.forEach((item, index) => {
        const itemLogical = index === 5 ? 0 : index;
        if (itemLogical === logicalIndex) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });
    }

    // Scroll al elemento
    function scrollToIndex(index: number) {
      const itemWidth = currentItemWidth + currentGap;
      if (!carousel) return;
      carousel.scrollTo({
        left: index * itemWidth,
        behavior: 'auto'
      });
    }

    // Rotación automática
    function startAutoRotate() {
      autoRotateInterval = setInterval(() => {
        activeIndex = (activeIndex + 1) % 5;
        scrollToIndex(activeIndex);
        updateActive();
      }, 5000);
    }

    function stopAutoRotate() {
      if (autoRotateInterval !== null) {
        clearInterval(autoRotateInterval);
      }
    }

    // Event listeners para botones
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const itemWidth = currentItemWidth + currentGap;
        if (carousel.scrollLeft <= itemWidth / 2) {
          carousel.scrollTo({ left: 4 * itemWidth, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: -itemWidth, behavior: 'smooth' });
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const itemWidth = currentItemWidth + currentGap;
        carousel.scrollTo({ left: carousel.scrollLeft + itemWidth, behavior: 'smooth' });
      });
    }



    // Pausar en hover
    carousel.addEventListener('mouseenter', stopAutoRotate);
    carousel.addEventListener('mouseleave', startAutoRotate);

    // Actualizar al hacer scroll
    carousel.addEventListener('scroll', () => {
      const scrollPos = carousel.scrollLeft;
      const itemWidth = currentItemWidth + currentGap;
      let newIndex = Math.round(scrollPos / itemWidth);
      if (newIndex === 5) {
        carousel.scrollTo({ left: 0, behavior: 'auto' });
        newIndex = 0;
      }
      if (newIndex !== activeIndex) {
        activeIndex = newIndex;
        updateActive();
      }
    });

    // Inicializar
    updateActive();
    startAutoRotate();

    // Ajustar items por pantalla en resize
    function adjustItems() {
      const width = window.innerWidth;
      if (!carousel) return;
      const container = carousel.querySelector('div');
      if (!container) return;

      let itemsToShow = 1;
      let itemWidth = 280;
      let gap = 32;

      if (width >= 1024) {
        itemsToShow = 4;
        itemWidth = 240;
        gap = 24;
      } else if (width >= 768) {
        itemsToShow = 3;
        itemWidth = 240;
        gap = 24;
      } else if (width >= 640) {
        itemsToShow = 2;
        itemWidth = 260;
        gap = 24;
      }



      const cards = container.querySelectorAll('div');
      cards.forEach(card => {
        card.style.width = `${itemWidth}px`;
      });

      container.style.gap = `${gap}px`;

      updateActive();
    }

    adjustItems();
    window.addEventListener('resize', adjustItems);
  })();
</script>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .active img {
    filter: grayscale(0%) !important;
  }

  .active .rounded-full {
    border-color: #3b82f6 !important; /* Ajustar según el color primary */
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.3) !important;
  }
</style>