---
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

const soluciones = [
  {
    title: 'Atracción y Selección',
    description: 'Encontramos el talento ideal que tu empresa necesita para crecer.',
    href: '/empresas#atraccion-seleccion',
    image: '/images/vieja-web/ATRACCIÓN.JPG',
  },
  {
    title: 'Desarrollo del Talento',
    description: 'Potenciamos el desempeño de tu equipo y llevamos su talento al siguiente nivel.',
    href: '/empresas#desarrollo-talento',
    image: '/images/vieja-web/DESARROLLO.HEIC',
  },
  {
    title: 'Formación y Liderazgo',
    description: 'Formamos líderes que inspiran, guían y generan resultados.',
    href: '/empresas#formacion-liderazgo',
    image: '/images/vieja-web/FORMACIÓN.heic',
  },
  {
    title: 'Bienestar y Cultura',
    description: 'Construimos una cultura sólida donde las personas y el negocio prosperen.',
    href: '/empresas#bienestar-cultura',
    image: '/images/vieja-web/BIENESTAR.jpg',
  },
  {
    title: 'Salud Psicosocial',
    description: 'Cuidamos el bienestar emocional de tu equipo y fortalecemos su productividad.',
    href: '/empresas#salud-psicosocial',
    image: '/images/vieja-web/SALUD-LABORAL.JPG',
  },
];
---

<section class="py-24 bg-white" id="soluciones">
  <div class="container-page">
    <SectionTitle 
      title="Soluciones para empresas"
      subtitle="Cada servicio está diseñado para resolver problemas específicos de talento."
    />
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      {soluciones.map((solucion) => (
        <a href={solucion.href} class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="aspect-video overflow-hidden">
            <img 
              src={solucion.image} 
              alt={solucion.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-6">
            <h3 class="text-lg font-heading font-bold text-text-dark mb-2 group-hover:text-primary transition-colors">
              {solucion.title}
            </h3>
            <p class="text-text-medium text-sm">
              {solucion.description}
            </p>
          </div>
        </a>
      ))}
    </div>
    
    <div class="text-center mt-12">
      <Button href="/empresas" variant="secondary">
        Ver todas las soluciones →
      </Button>
    </div>
  </div>
</section>
