---
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

const soluciones = [
  {
    title: 'Atracción y Selección',
    description: 'Encontramos el talento ideal que tu empresa necesita para crecer.',
    href: '/empresas#atraccion-seleccion',
    image: '/images/vieja-web/ATRACCIÓN.JPG',
  },
  {
    title: 'Desarrollo y Valoración del Talento',
    description: 'Potenciamos el desempeño de tu equipo y llevamos su talento al siguiente nivel.',
    href: '/empresas#desarrollo-talento',
    image: '/images/vieja-web/DESARROLLO.HEIC',
  },
  {
    title: 'Formación y Liderazgo',
    description: 'Formamos líderes que inspiran, guían y generan resultados.',
    href: '/empresas#formacion-liderazgo',
    image: '/images/vieja-web/FORMACIÓN.heic',
  },
  {
    title: 'Bienestar y Cultura Organizacional',
    description: 'Construimos una cultura sólida donde las personas y el negocio prosperen.',
    href: '/empresas#bienestar-cultura',
    image: '/images/vieja-web/BIENESTAR.jpg',
  },
  {
    title: 'Salud Psicosocial',
    description: 'Cuidamos el bienestar emocional de tu equipo y fortalecemos su productividad.',
    href: '/empresas#salud-psicosocial',
    image: '/images/vieja-web/SALUD-LABORAL.JPG',
  },
];
---

<section class="py-24 bg-white" id="soluciones">
  <div class="container-page">
    <SectionTitle 
      title="Soluciones para empresas"
      subtitle="Cada servicio está diseñado para resolver problemas específicos de talento."
      align="center"
    />
    
    <!-- Carrusel de soluciones -->
    <div class="relative mt-12 group">
      <!-- Contenedor del carrusel con scroll snap -->
      <div id="soluciones-carousel" class="flex overflow-x-auto scrollbar-hide scroll-smooth snap-x snap-mandatory">
        <div class="flex gap-6 px-4">
          {soluciones.map((solucion) => (
            <div class="flex-none w-[85vw] sm:w-[70vw] md:w-[45vw] lg:w-[350px] snap-start">
              <a href={solucion.href} class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all hover:-translate-y-1 h-full flex flex-col">
                <div class="aspect-video overflow-hidden flex-shrink-0">
                  <img 
                    src={solucion.image} 
                    alt={solucion.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-6 flex-1 flex flex-col">
                  <h3 class="text-lg font-heading font-bold text-text-dark mb-2 group-hover:text-primary transition-colors">
                    {solucion.title}
                  </h3>
                  <p class="text-text-medium text-sm flex-1">
                    {solucion.description}
                  </p>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Botón anterior -->
      <button 
        id="soluciones-prev"
        class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg hover:bg-gray-50 transition-colors opacity-0 group-hover:opacity-100"
        aria-label="Anterior"
      >
        <svg class="w-5 h-5 text-text-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Botón siguiente -->
      <button 
        id="soluciones-next"
        class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg hover:bg-gray-50 transition-colors opacity-0 group-hover:opacity-100"
        aria-label="Siguiente"
      >
        <svg class="w-5 h-5 text-text-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Script del carrusel con loop infinito -->
    <script>
      (function() {
        const carousel = document.getElementById('soluciones-carousel');
        const prevBtn = document.getElementById('soluciones-prev');
        const nextBtn = document.getElementById('soluciones-next');
        
        if (!carousel || !prevBtn || !nextBtn) return;

        const cardWidth = 350 + 24; // ancho tarjeta (350px) + gap (24px)
        const scrollAmount = cardWidth;

        function getScrollPosition() {
          return carousel.scrollLeft;
        }

        function scrollToPosition(position) {
          carousel.scrollTo({ left: position, behavior: 'smooth' });
        }

        prevBtn.addEventListener('click', () => {
          const currentPos = getScrollPosition();
          if (currentPos <= 0) {
            // Ir al final (loop)
            scrollToPosition(carousel.scrollWidth - carousel.clientWidth);
          } else {
            scrollToPosition(currentPos - scrollAmount);
          }
        });

        nextBtn.addEventListener('click', () => {
          const currentPos = getScrollPosition();
          const maxScroll = carousel.scrollWidth - carousel.clientWidth;
          if (currentPos >= maxScroll - 10) {
            // Volver al inicio (loop)
            scrollToPosition(0);
          } else {
            scrollToPosition(currentPos + scrollAmount);
          }
        });
      })();
    </script>

    <style>
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
    </style>
    
    <div class="text-center mt-12">
      <Button href="/empresas" variant="secondary">
        Ver todas las soluciones →
      </Button>
    </div>
  </div>
</section>
