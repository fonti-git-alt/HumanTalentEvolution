---
const clientes = [
  { name: 'Wildlife Works', logo: '/images/reduxfotos/clientes/wildlife works.png' },
  { name: 'Proeco', logo: '/images/reduxfotos/clientes/proeco.png' },
  { name: 'Pactia', logo: '/images/reduxfotos/clientes/Pactia.png' },
  { name: 'Maken', logo: '/images/reduxfotos/clientes/Maken.png' },
  { name: 'Los Olivos', logo: '/images/reduxfotos/clientes/Los olivos.png' },
  { name: 'Logika', logo: '/images/reduxfotos/clientes/logika.png' },
  { name: 'Grupo Argos', logo: '/images/reduxfotos/clientes/Grupo Argos.png' },
  { name: 'GMAS', logo: '/images/reduxfotos/clientes/gmas.png' },
  { name: 'Globus', logo: '/images/reduxfotos/clientes/Globus.png' },
  { name: 'Fondeargos', logo: '/images/reduxfotos/clientes/Fondeargos.png' },
  { name: 'Emu', logo: '/images/reduxfotos/clientes/emu.png' },
  { name: 'DP', logo: '/images/reduxfotos/clientes/dp.png' },
  { name: 'Discurramba SA', logo: '/images/reduxfotos/clientes/Discurramba sa.png' },
  { name: 'Comfaguajira', logo: '/images/reduxfotos/clientes/Comfaguajira.png' },
  { name: 'Colchones Serrati', logo: '/images/reduxfotos/clientes/Colchones serrati.png' },
  { name: 'Bordeus', logo: '/images/reduxfotos/clientes/Bordeus.png' },
  { name: '3Net', logo: '/images/reduxfotos/clientes/3net.png' },
];
---

<section class="py-20 bg-primary-lighter overflow-hidden">
  <div class="container-page mb-10">
    <div class="text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark">
        Empresas que confían en nosotros
      </h2>
      <p class="text-text-medium mt-3 max-w-xl mx-auto">
        Organizaciones que han transformado su gestión del talento con nuestra ayuda.
      </p>
    </div>
  </div>
  
  <!-- Carousel container -->
  <div class="relative group">
    <!-- Gradiente overlays para efecto smooth en bordes -->
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-primary-lighter to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-primary-lighter to-transparent z-10 pointer-events-none"></div>
    
    <!-- Track con animación infinita -->
    <div class="flex" id="carousel-track">
      <!-- Duplicamos los clientes para efecto infinite seamless -->
      {[...clientes, ...clientes, ...clientes].map((cliente) => (
        <div class="flex-shrink-0 w-32 md:w-40 mx-4">
          <div class="bg-white rounded-2xl p-6 md:p-8 flex items-center justify-center grayscale hover:grayscale-0 transition-all duration-300 hover:shadow-lg hover:scale-105 cursor-pointer">
            <img src={cliente.logo} alt={cliente.name} class="w-20 h-20 md:w-24 md:h-24 object-contain" />
          </div>

        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('carousel-track');
  
  let isPaused = false;
  let animationId: number | null = null;
  let currentPosition = 0;
   let speed = 1.2;

  const itemWidth = 144;
  const totalItems = 51;
  const oneCyclePosition = itemWidth * totalItems;

  function animate() {
    if (isPaused || !track) return;
    
    currentPosition -= speed;
    
    if (currentPosition <= -oneCyclePosition) {
      currentPosition = 0;
    }
    
    track.style.transform = `translateX(${currentPosition}px)`;
    animationId = requestAnimationFrame(animate);
  }

  function pause() {
    isPaused = true;
  }

  function resume() {
    isPaused = false;
    animationId = requestAnimationFrame(animate);
  }

  // Iniciar
  resume();

  // Pausar en hover
  track?.addEventListener('mouseenter', pause);
  track?.addEventListener('mouseleave', resume);
</script>