---
import SectionTitle from '../ui/SectionTitle.astro';

const problemas = [
  {
    title: 'Liderazgo',
    description: 'Desarrollamos líderes que inspiran, guían y generan resultados.',
    icon: '👔',
  },
  {
    title: 'Capacidad de análisis',
    description: 'Datos objetivos para tomar decisiones de talento informadas.',
    icon: '📊',
  },
  {
    title: 'Orientación a resultados',
    description: 'Transformamos el talento en impacto medible para el negocio.',
    icon: '🎯',
  },
  {
    title: 'Desarrollo continuo',
    description: 'Potenciamos el crecimiento profesional de tu equipo.',
    icon: '📈',
  },
];
---

<section class="py-24 bg-white">
  <div class="container-page">
    <SectionTitle 
      title="¿Te suena familiar?"
      subtitle="Las empresas crecen, pero el talento no siempre evoluciona al mismo ritmo. Estos problemas son más comunes de lo que imaginas."
    />
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
      {problemas.map((problema, index) => (
        <div class="card border-l-4 border-l-primary/30 hover:border-l-primary transition-colors">
          <div class="text-4xl mb-4">{problema.icon}</div>
          <h3 class="text-lg font-heading font-semibold text-text-dark mb-2">{problema.title}</h3>
          <p class="text-text-medium text-sm">{problema.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
