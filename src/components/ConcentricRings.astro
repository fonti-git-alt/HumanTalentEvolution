---
// ConcentricRings.astro - Cuatro anillos concéntricos con texto arqueado
// NOMENCLATURA OFICIAL (desde externo hacia centro):
//   Anillo 1: Más externo - stroke, color #dad1f6 (primary-lighter)
//   Anillo 2: Intermedio externo - stroke, color #6a2f77 (primary-dark)
//   Anillo 3: Intermedio central - stroke, color #8f4c9f (primary)
//   Anillo 4: CENTRO - círculo relleno sólido, color #B58FCB (acento intermedio)
// NOTA: El "anillo 4" NO es un anillo con stroke, es un círculo relleno central.
interface Props {
  rings?: number;
  text?: string;
  texts?: Array<{ top: string; bottom: string }>;
  size?: number;
  thickness?: number;
}

const { rings = 4, text = "Texto Arqueado", texts, size = 300, thickness = 12 } = Astro.props;

// Si se proporciona texts[], usar ese array; si no, crear objetos con mismo texto para top y bottom
const ringTexts = texts || Array(rings).fill({ top: text, bottom: text });

// Colores de la marca HTE - orden: externo a interno
const colors = [
  '#dad1f6', // Anillo 1 - primary-lighter (más externo)
  '#6a2f77', // Anillo 2 - primary-dark
  '#8f4c9f', // Anillo 3 - primary
  '#B58FCB', // Anillo 4 (centro) - color intermedio/acento
];

// Offsets para texto (distancia desde el borde interno del aro hasta el texto)
const textOffsetTop = 15;    // texto superior: 15px desde el borde interno
const textOffsetBottom = 15; // texto inferior: 15px desde el borde interno
---

<div class="concentric-rings-container flex items-center justify-center p-8">
  <svg
    width={size}
    height={size}
    viewBox={`${-size/2 - 50} ${-size/2 - 50} ${size + 100} ${size + 100}`}
    class="concentric-rings-svg"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Paths para textos en cada anillo (superior e inferior) - 3 anillos exteriores -->
      {Array.from({ length: 3 }, (_, i) => {
        const baseRadius = size / 2 - 20;
        const gap = 1;
        let radius;
        if (i === 2) {
          const prevRingRadius = baseRadius - (i - 1) * (thickness + gap);
          radius = prevRingRadius - thickness / 2 - gap;
        } else {
          radius = baseRadius - i * (thickness + gap);
        }
        // Radios independientes para texto superior e inferior
        const textRadiusTop = radius - thickness - textOffsetTop;
        const textRadiusBottom = radius - thickness / 2 - textOffsetBottom;
        const topPath = `M ${-textRadiusTop} 0 A ${textRadiusTop} ${textRadiusTop} 0 0 1 ${textRadiusTop} 0`;
        const bottomPath = `M ${-textRadiusBottom} 0 A ${textRadiusBottom} ${textRadiusBottom} 0 0 0 ${textRadiusBottom} 0`;
        return (
          <>
            <path id={`text-top-${i}`} d={topPath} fill="none" />
            <path id={`text-bottom-${i}`} d={bottomPath} fill="none" />
          </>
        );
      })}
    </defs>

    <g id="concentric-group">
      <!-- 3 anillos exteriores (stroke only) -->
      {Array.from({ length: 3 }, (_, i) => {
        const baseRadius = size / 2 - 20;
        const gap = 1;
        const radius = baseRadius - i * (thickness + gap);
        const color = colors[i];
        return (
          <circle
            cx={0}
            cy={0}
            r={radius}
            fill="none"
            stroke={color}
            stroke-width={thickness}
            class="ring"
            style={`--glow-color: ${color === '#dad1f6' ? 'rgba(217, 209, 246, 0.6)' : color === '#6a2f77' ? 'rgba(106, 47, 119, 0.6)' : 'rgba(143, 76, 159, 0.6)'}`}
          />
        );
      })}

      <!-- Cuarto "anillo": círculo central relleno -->
      <circle
        cx={0}
        cy={0}
        r={size / 2 - 20 - 3 * (thickness + 1) - thickness / 2 - 2}
        fill={colors[3]}
        class="center-circle"
        style={`--glow-color: rgba(181, 143, 203, 0.6); transition: all 0.3s ease;`}
      />

      <!-- Fondo y texto separador central -->
      <rect x={-size/2 - 30} y={-15} width={size + 60} height={30} fill="#f5f3f0" />
      <text x={0} y={5} font-size="16" fill="#1a1a2e" font-family="Plus Jakarta Sans, sans-serif" font-weight="700" text-anchor="middle">
        {text}
      </text>

      <!-- Textos arqueados superiores (solo para 3 anillos exteriores) -->
      {Array.from({ length: 3 }, (_, i) => (
        <text font-size="18" fill="#1a1a2e" font-family="Plus Jakarta Sans, sans-serif" font-weight="600" text-anchor="middle">
          <textPath href={`#text-top-${i}`} startOffset="50%">
            {ringTexts[i]?.top || ringTexts[i]?.bottom || text}
          </textPath>
        </text>
      ))}

      <!-- Textos arqueados inferiores (solo para 3 anillos exteriores) -->
      {Array.from({ length: 3 }, (_, i) => (
        <text font-size="18" fill="#1a1a2e" font-family="Plus Jakarta Sans, sans-serif" font-weight="600" text-anchor="middle">
          <textPath href={`#text-bottom-${i}`} startOffset="50%">
            {ringTexts[i]?.bottom || ringTexts[i]?.top || text}
          </textPath>
        </text>
      ))}
    </g>
  </svg>
</div>

<style>
  .ring:hover,
  .center-circle:hover {
    filter: brightness(1.3) drop-shadow(0 0 8px var(--glow-color, rgba(255, 255, 255, 0.6)));
    transition: all 0.3s ease;
  }
</style>
