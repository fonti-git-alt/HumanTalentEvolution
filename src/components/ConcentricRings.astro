---
// ConcentricRings.astro - Componente con aros concéntricos y texto arqueado
interface Props {
  rings?: number;
  text?: string;
  texts?: Array<{ top: string; bottom: string }>;
  size?: number;
  thickness?: number;
}

const { rings = 4, text = "Texto Arqueado", texts, size = 300, thickness = 3 } = Astro.props;

// Si se proporciona texts[], usar ese array; si no, crear objetos con mismo texto para top y bottom
const ringTexts = texts || Array(rings).fill({ top: text, bottom: text });

// Colores de la marca HTE - orden: externo a interno
const colors = [
  '#dad1f6', // primary-lighter (más externo)
  '#6a2f77', // primary-dark (segundo)
  '#8f4c9f', // primary (tercero)
  '#B58FCB', // color intermedio (centro)
];

// Offsets para texto (distancia desde el borde interno del aro hasta el texto)
const textOffsetTop = 15;    // texto superior: 15px desde el borde interno
const textOffsetBottom = 15; // texto inferior: 15px desde el borde interno
---

<div class="concentric-rings-container flex items-center justify-center p-8">
  <svg
    width={size}
    height={size}
    viewBox={`${-size/2 - 50} ${-size/2 - 50} ${size + 100} ${size + 100}`}
    class="concentric-rings-svg"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Paths para textos en cada anillo (superior e inferior) -->
      {Array.from({ length: rings }, (_, i) => {
        const baseRadius = size / 2 - 20;
        const gap = 2;
        let radius;
        if (i === rings - 1) {
          const prevRingRadius = baseRadius - (i - 1) * (thickness + gap);
          radius = prevRingRadius - thickness / 2 - gap;
        } else {
          radius = baseRadius - i * (thickness + gap);
        }
        // Radios independientes para texto superior e inferior
        const textRadiusTop = radius - thickness / 5 - textOffsetTop;
        const textRadiusBottom = radius - thickness / 12 - textOffsetBottom;
        const topPath = `M ${-textRadiusTop} 0 A ${textRadiusTop} ${textRadiusTop} 0 0 1 ${textRadiusTop} 0`;
        const bottomPath = `M ${-textRadiusBottom} 0 A ${textRadiusBottom} ${textRadiusBottom} 0 0 0 ${textRadiusBottom} 0`;
        return (
          <>
            <path id={`text-top-${i}`} d={topPath} fill="none" />
            <path id={`text-bottom-${i}`} d={bottomPath} fill="none" />
          </>
        );
      })}
    </defs>

    <g id="concentric-group">
      <!-- Aros concéntricos -->
      {Array.from({ length: rings }, (_, i) => {
        const baseRadius = size / 2 - 20;
        const gap = 1;
        const isInnermost = i === rings - 1;
        
        let radius;
        if (isInnermost) {
          const prevRingRadius = baseRadius - (i - 1) * (thickness + gap);
          radius = prevRingRadius - thickness / 2 - gap;
        } else {
          radius = baseRadius - i * (thickness + gap);
        }
        
        const strokeWidth = thickness;
        const color = colors[i] || colors[colors.length - 1];
        return (
          <circle
            cx={0}
            cy={0}
            r={radius}
            fill={isInnermost ? color : "none"}
            stroke={isInnermost ? "none" : color}
            stroke-width={isInnermost ? 0 : strokeWidth}
            class={isInnermost ? "innermost-circle" : "ring"}
            style={`transition: all 0.3s ease;`}
          />
        );
      })}

      <!-- Fondo y texto separador central -->
      <rect x={-size/2} y={-15} width={size} height={30} fill="#dad1f6" opacity="0.9" />
      <text x={0} y={5} font-size="16" fill="#1a1a2e" font-family="Plus Jakarta Sans, sans-serif" font-weight="700" text-anchor="middle">
        TEXTO SEPARADOR
      </text>

      <!-- Textos arqueados superiores -->
      {Array.from({ length: rings }, (_, i) => (
        <text font-size="18" fill="#1a1a2e" font-family="Plus Jakarta Sans, sans-serif" font-weight="600" text-anchor="middle">
          <textPath href={`#text-top-${i}`} startOffset="50%">
            {ringTexts[i].top}
          </textPath>
        </text>
      ))}

      <!-- Textos arqueados inferiores -->
      {Array.from({ length: rings }, (_, i) => (
        <text font-size="18" fill="#1a1a2e" font-family="Plus Jakarta Sans, sans-serif" font-weight="600" text-anchor="middle">
          <textPath href={`#text-bottom-${i}`} startOffset="50%">
            {ringTexts[i].bottom}
          </textPath>
        </text>
      ))}
    </g>
  </svg>
</div>

<style>
  .ring:hover {
    filter: brightness(1.3);
  }
  .innermost-circle:hover {
    filter: brightness(1.3) drop-shadow(0 0 8px rgba(255, 255, 255, 0.6));
    transition: all 0.3s ease;
  }
</style>
