---
// ConcentricRings.astro - Componente con aros concéntricos y texto arqueado
interface Props {
  rings?: number;
  text?: string;
  size?: number;
  thickness?: number;
}

const { rings = 4, text = "Texto Arqueado", size = 300, thickness = 3 } = Astro.props;
---

<div class="concentric-rings-container flex items-center justify-center p-8">
  <svg
    width={size}
    height={size}
    viewBox={`${-size/2 - 30} ${-size/2 - 30} ${size + 60} ${size + 60}`}
    class="concentric-rings-svg"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Caminos para texto dentro del aro exterior -->
      {(() => {
        const outerRadius = (size / 2 - 20) * (1 - 0 * 0.15);
        const outerThickness = thickness + 0 * 0.5;
        const textRadius = outerRadius - outerThickness / 2 - 2;
        const textPath = `M ${-textRadius} 0 A ${textRadius} ${textRadius} 0 1 1 ${textRadius} 0`;
        return (
          <path
            id="inner-text-arc"
            d={textPath}
            fill="none"
          />
        );
      })()}

      <!-- Caminos para textos fuera del círculo más grande -->
      {(() => {
        const outerTextRadius = size / 2 + 30;
        const midLeft = -outerTextRadius / 4;
        const midRight = outerTextRadius / 4;

        return (
          <>

          </>
        );
      })()}
    </defs>

    <g id="concentric-group">
      <!-- Aros concéntricos -->
    {Array.from({ length: rings }, (_, i) => {
      const radius = (size / 2 - 20) * (1 - i * 0.15);
      const strokeWidth = thickness + i * 0.5;
      const isInnermost = i === rings - 1;
      return (
        <circle
          cx={0}
          cy={0}
          r={radius}
          fill={isInnermost ? `hsl(${200 + i * 30}, 70%, ${50 + i * 10}%)` : "none"}
          stroke={isInnermost ? "none" : `hsl(${200 + i * 30}, 70%, ${50 + i * 10}%)`}
          stroke-width={isInnermost ? 0 : strokeWidth}
          class={isInnermost ? "innermost-circle" : "ring"}
          style={`transition: all 0.3s ease;`}
        />
      );
    })}

    <!-- Texto arqueado dentro -->
    <text
      font-size="18"
      fill="white"
      font-family="Plus Jakarta Sans, sans-serif"
      font-weight="600"
      text-anchor="middle"
    >
      <textPath href="#inner-text-arc" startOffset="50%">
        {text}
      </textPath>
    </text>



    <!-- Fondo para el texto separador -->
    <rect
      x={-size / 2}
      y={-15}
      width={size}
      height="30"
      fill="white"
      opacity="1"
    />

    <!-- Texto horizontal separador -->
    <text
      x={0}
      y={5}
      font-size="16"
      fill="#1f2937"
      font-family="Plus Jakarta Sans, sans-serif"
      font-weight="700"
      text-anchor="middle"
    >
      TEXTO SEPARADOR
    </text>
    </g>

  </svg>
</div>

<style>
  .ring:hover {
    filter: brightness(1.3);
  }

  .center-circle:hover {
    filter: brightness(1.3);
    transition: all 0.3s ease;
  }

  .innermost-circle:hover {
    filter: brightness(1.3);
    transition: all 0.3s ease;
  }



  .innermost-circle:hover {
    filter: brightness(1.3) drop-shadow(0 0 8px rgba(255, 255, 255, 0.6));
    transition: all 0.3s ease;
  }
</style>