---
// ConcentricRings.astro - Componente con aros concéntricos y texto arqueado
interface Props {
  rings?: number;
  text?: string;
  size?: number;
  thickness?: number;
}

const { rings = 4, text = "Texto Arqueado", size = 300, thickness = 3 } = Astro.props;

// Colores de la marca HTE - orden: externo a interno
// Aro 0 (más externo): primary-lighter (morado claro)
// Aro 1: primary-dark (morado oscuro)
// Aro 2: primary (morado principal)
// Centro: color intermedio entre primary-lighter y primary
const colors = [
  '#dad1f6', // primary-lighter (más externo)
  '#6a2f77', // primary-dark (segundo)
  '#8f4c9f', // primary (tercero)
  '#B58FCB', // color intermedio (centro)
];
---

<div class="concentric-rings-container flex items-center justify-center p-8">
   <svg
     width={size}
     height={size}
     viewBox={`${-size/2 - 30} ${-size/2 - 30} ${size + 60} ${size + 60}`}
     class="concentric-rings-svg"
     xmlns="http://www.w3.org/2000/svg"
   >
      <defs>
        <!-- Path para texto arqueado superior e inferior -->
        {(() => {
          const outerRadius = (size / 2 - 20) * (1 - 0 * 0.15);
          const outerThickness = thickness + 0 * 0.5;
          // Radio para texto superior (posición actual)
          const textRadiusTop = outerRadius - outerThickness / 5;
          // Radio para texto inferior: 2px más pequeño → más cerca del centro
          const textRadiusBottom = outerRadius - outerThickness / 5;

          // Arco superior: sweep flag 1 (por arriba)
          const topArcPath = `M ${-textRadiusTop} 0 A ${textRadiusTop} ${textRadiusTop} 0 0 1 ${textRadiusTop} 0`;
          // Arco inferior: sweep flag 0 (por abajo)
          const bottomArcPath = `M ${-textRadiusBottom} 0 A ${textRadiusBottom} ${textRadiusBottom} 0 0 0 ${textRadiusBottom} 0`;
          return (
            <>
              <path id="text-arc-top" d={topArcPath} fill="none" />
              <path id="text-arc-bottom" d={bottomArcPath} fill="none" />
            </>
          );
        })()}
      </defs>

     <g id="concentric-group">
       <!-- Aros concéntricos -->
       {Array.from({ length: rings }, (_, i) => {
         const baseRadius = size / 2 - 20;
         const gap = 1;
         const isInnermost = i === rings - 1;
         
         let radius;
         if (isInnermost) {
           const prevRingRadius = baseRadius - (i - 1) * (thickness + gap);
           radius = prevRingRadius - thickness / 2 - gap;
         } else {
           radius = baseRadius - i * (thickness + gap);
         }
         
         const strokeWidth = thickness;
         const color = colors[i] || colors[colors.length - 1];
         return (
           <circle
             cx={0}
             cy={0}
             r={radius}
             fill={isInnermost ? color : "none"}
             stroke={isInnermost ? "none" : color}
             stroke-width={isInnermost ? 0 : strokeWidth}
             class={isInnermost ? "innermost-circle" : "ring"}
             style={`transition: all 0.3s ease;`}
           />
         );
       })}

       <!-- Fondo para el texto separador -->
       <rect
         x={-size / 2}
         y={-15}
         width={size}
         height="30"
         fill="#dad1f6"
         opacity="0.9"
       />

       <!-- Texto horizontal separador -->
       <text
         x={0}
         y={5}
         font-size="16"
         fill="#1a1a2e"
         font-family="Plus Jakarta Sans, sans-serif"
         font-weight="700"
         text-anchor="middle"
       >
         TEXTO SEPARADOR
       </text>

        <!-- Texto arqueado superior (centrado en arco superior) -->
        <text
          font-size="18"
          fill="#1a1a2e"
          font-family="Plus Jakarta Sans, sans-serif"
          font-weight="600"
          text-anchor="middle"
        >
          <textPath href="#text-arc-top" startOffset="50%">
            {text}
          </textPath>
        </text>

        <!-- Texto arqueado inferior (centrado en arco inferior, compensado +2%) -->
        <text
          font-size="18"
          fill="#1a1a2e"
          font-family="Plus Jakarta Sans, sans-serif"
          font-weight="600"
          text-anchor="middle"
        >
          <textPath href="#text-arc-bottom" startOffset="50%">
            {text}
          </textPath>
        </text>
     </g>
   </svg>
</div>

<style>
  .ring:hover {
    filter: brightness(1.3);
  }

  .center-circle:hover {
    filter: brightness(1.3);
    transition: all 0.3s ease;
  }

  .innermost-circle:hover {
    filter: brightness(1.3);
    transition: all 0.3s ease;
  }



  .innermost-circle:hover {
    filter: brightness(1.3) drop-shadow(0 0 8px rgba(255, 255, 255, 0.6));
    transition: all 0.3s ease;
  }
</style>
