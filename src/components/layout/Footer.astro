---
const quickLinks = [
  { href: '/empresas', label: 'Soluciones para Empresas' },
  { href: '/personas', label: 'Soluciones para Personas' },
  { href: '/metodologia', label: 'Metodología' },
  { href: '/quienes-somos', label: 'Quiénes Somos' },
];

const legalLinks = [
  { href: '/contacto', label: 'Contacto' },
  { href: 'https://humantalentevolution.psy-tech.net/login', label: 'Registra tu hoja de vida', external: true },
];
---

<footer class="bg-text-dark text-white/80">
  <div class="container-page py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <span class="text-white font-heading font-bold text-lg">HTE</span>
          </div>
          <span class="font-heading font-semibold text-white">Human Talent Evolution</span>
        </a>
        <p class="text-white/60 max-w-md mb-6">
          Consultora especializada en valoración del talento humano. Impulsamos el crecimiento de las empresas a través de su talento.
        </p>
        <p class="text-sm text-white/40">
          © {new Date().getFullYear()} Human Talent Evolution. Todos los derechos reservados.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4">Soluciones</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal & Contact -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4">Contacto</h4>
        <ul class="space-y-3">
          {legalLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class={`hover:text-primary transition-colors ${link.external ? 'flex items-center gap-1' : ''}`}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
                {link.external && (
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>
