---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { 
    label: 'Empresas', 
    href: '/empresas',
    children: [
      { 
        label: 'Atracción y Selección de Talentos', 
        href: '/empresas#atraccion-seleccion' 
      },
      { 
        label: 'Desarrollo y Valoración del Talento', 
        href: '/empresas#desarrollo-talento' 
      },
      { 
        label: 'Formación y Liderazgo', 
        href: '/empresas#formacion-liderazgo' 
      },
      { 
        label: 'Bienestar y Cultura Organizacional', 
        href: '/empresas#bienestar-cultura' 
      },
      { 
        label: 'Salud y Gestión de Riesgo Psicosocial', 
        href: '/empresas#salud-psicosocial' 
      },
    ]
  },
  { href: '/candidatos', label: 'Candidatos' },
  { href: '/quienes-somos', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header 
  id="main-header" 
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-out"
>
  <!-- Desktop header background -->
  <div 
    id="header-bg"
    class="absolute inset-0 transition-all duration-300 ease-out hidden lg:block"
  ></div>
  
  <!-- Desktop nav content -->
  <nav id="header-nav" class="container-page relative transition-all duration-300 ease-out hidden lg:block">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center group">
        <img
          src="/images/reduxfotos/Logo horizontal.png"
          alt="Human Talent Evolution"
          class="h-12 lg:h-16"
        />
      </a>

       <!-- Desktop nav -->
       <div class="hidden lg:flex items-center gap-4 xl:gap-6">
         {navLinks.map((link) => (
           link.children ? (
             <div class="relative group dropdown">
               <a 
                 href={link.href}
                 class={`font-medium flex items-center gap-1 py-1 text-sm transition-colors hover:text-primary ${
                   link.children.some(item => currentPath === item.href)
                     ? 'text-primary' : 'text-text-medium'
                 }`}
               >
                 {link.label}
                 <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                 </svg>
               </a>
               <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                 <div class="bg-white rounded-xl shadow-xl border border-gray-100 py-2 min-w-72">
                   {link.children.map(item => (
                     <div class="px-3 py-1.5 hover:bg-gray-50">
                       <a 
                         href={item.href}
                         class={`block font-heading font-medium text-sm transition-colors hover:text-primary ${
                           currentPath === item.href ? 'text-primary' : 'text-text-medium'
                         }`}
                       >
                         {item.label}
                       </a>
                     </div>
                   ))}
                 </div>
               </div>
             </div>
           ) : (
             <a 
               href={link.href} 
               class={`font-medium text-sm py-1 transition-colors hover:text-primary ${
                 currentPath === link.href ? 'text-primary' : 'text-text-medium'
               }`}
             >
               {link.label}
             </a>
           )
         ))}
       </div>

        <!-- CTA -->
        <div class="hidden lg:flex items-center gap-2">
          <a 
            href="https://humantalentevolution.psy-tech.net/login"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm hidden sm:inline-flex"
          >
            Registra tu CV
          </a>
        </div>
    </div>
  </nav>

    <!-- Mobile header (simple bar across top) -->
    <div id="mobile-header" class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-transparent transition-opacity duration-300 ease-out opacity-100">
    <div class="flex items-center justify-between h-16 px-4">
      <a href="/" class="flex items-center">
        <img
          src="/images/reduxfotos/Logo horizontal.png"
          alt="Human Talent Evolution"
          class="h-12"
        />
      </a>
      
      <button 
        id="mobile-menu-btn" 
        class="p-2 text-text-dark hover:text-primary transition-colors"
        aria-label="Abrir menú"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer (slides from right) -->
  <div id="mobile-menu" class="fixed inset-y-0 right-0 w-80 max-w-[85vw] bg-white shadow-2xl z-50 hidden lg:hidden transform translate-x-full transition-transform duration-300 ease-out">
    <div class="flex flex-col h-full overflow-y-auto">
      <!-- Header del drawer -->
      <div class="flex items-center justify-between p-6 border-b border-gray-100">
        <a href="/" class="flex items-center" onclick="document.getElementById('mobile-menu').classList.add('hidden');document.body.style.overflow=''">
          <img
            src="/images/reduxfotos/Logo horizontal.png"
            alt="Human Talent Evolution"
            class="h-12"
          />
        </a>
        <button id="mobile-menu-close" class="p-2 text-text-dark hover:text-primary transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
        <!-- Menu content -->
        <nav class="flex-1 p-6 space-y-1">
          {navLinks.map((link) => (
            link.children ? (
              <div class="mb-6">
                <a
                  href={link.href}
                  class={`text-sm font-heading font-semibold text-text-dark uppercase tracking-wide hover:text-primary transition-colors block mb-3`}
                >
                  {link.label}
                </a>
                <div class="space-y-1 pl-2 border-l-2 border-primary/20">
                  {link.children.map(item => (
                    <div class="py-1">
                      <a
                        href={item.href}
                        class={`block font-heading font-medium text-sm transition-colors hover:text-primary hover:translate-x-1 hover:pl-1 ${
                          currentPath === item.href ? 'text-primary font-semibold' : 'text-text-dark'
                        }`}
                      >
                        {item.label}
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={link.href}
                class={`block py-3 font-heading text-lg font-medium transition-colors hover:text-primary hover:bg-primary/5 rounded-lg px-3 ${
                  currentPath === link.href ? 'text-primary bg-primary/10 font-semibold' : 'text-text-dark'
                }`}
              >
                {link.label}
              </a>
            )
          ))}
        </nav>
      
        <!-- Footer del drawer -->
        <div class="p-6 border-t border-gray-100">
          <a 
            href="https://humantalentevolution.psy-tech.net/login" 
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg w-full"
          >
            Registra tu CV
          </a>
        </div>
    </div>
  </div>

  <!-- Overlay oscuro (fuera del drawer) -->
  <div id="mobile-menu-overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden opacity-0 transition-opacity duration-300"></div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileHeader = document.getElementById('mobile-header');
  
  // Desktop header morphing (lg+ only)
  const headerBg = document.getElementById('header-bg');
  const headerNav = document.getElementById('header-nav');
  let isScrolled = false;
  const SCROLL_THRESHOLD = 10;

  function updateHeaderMorphing(scrolled: boolean) {
    // Only morph on desktop (lg breakpoint and above)
    if (!headerBg || !headerNav || window.innerWidth < 1024) return;
    if (scrolled === isScrolled) return;
    isScrolled = scrolled;

    if (scrolled) {
      // SCROLLED: pill, wide, solid
      headerBg?.classList.add(
        'rounded-full',
        'mx-20',
        'mt-2',
        'shadow-xl',
        'border',
        'border-gray-100/50',
        'bg-white/95',
        'backdrop-blur-xl',
        'left-0',
        'right-0'
      );
      headerBg?.classList.remove(
        'rounded-none',
        'border-b',
        'bg-white/90',
        'backdrop-blur-md',
        'mx-1'
      );
      
      headerNav?.classList.remove('container-page');
      headerNav?.classList.add('max-w-5xl', 'mx-auto', 'px-6');
    } else {
      // TOP: transparent, narrow
      headerBg?.classList.add(
        'rounded-none',
        'mx-1'
      );
      headerBg?.classList.remove(
        'rounded-full',
        'border',
        'border-b',
        'border-gray-100/50',
        'bg-white/95',
        'bg-white/90',
        'backdrop-blur-xl',
        'backdrop-blur-md',
        'shadow-xl',
        'mx-20',
        'mt-2',
        'left-0',
        'right-0'
      );
      
      headerNav?.classList.remove('max-w-5xl', 'mx-auto', 'px-6');
      headerNav?.classList.add('container-page');
    }
  }

  function handleScroll() {
    const scrolled = window.scrollY > SCROLL_THRESHOLD;
    updateHeaderMorphing(scrolled);
  }

  handleScroll();
  window.addEventListener('scroll', handleScroll, { passive: true });

   // Mobile header: fade out on scroll down, fade in on scroll up
   let lastScrollY = window.scrollY;
   let mobileHidden = false;

   function updateMobileHeaderVisibility() {
     if (!mobileHeader || window.innerWidth >= 1024) return;

     const currentScrollY = window.scrollY;
     const scrollDelta = currentScrollY - lastScrollY;

     // Only hide/show if there's significant scroll movement
     if (Math.abs(scrollDelta) > 5) {
       if (scrollDelta > 0 && currentScrollY > 100 && !mobileHidden) {
         // Scrolling down past 100px - fade out header
         mobileHeader.classList.add('opacity-0');
         mobileHeader.classList.remove('opacity-100');
         mobileHidden = true;
       } else if (scrollDelta < 0 && mobileHidden) {
         // Scrolling up - fade in header
         mobileHeader.classList.remove('opacity-0');
         mobileHeader.classList.add('opacity-100');
         mobileHidden = false;
       }
     }

     lastScrollY = currentScrollY;
   }

   // Initialize mobile header visibility
   updateMobileHeaderVisibility();
   window.addEventListener('scroll', updateMobileHeaderVisibility, { passive: true });

  // Mobile drawer handlers
  const menuOverlay = document.getElementById('mobile-menu-overlay');
  
  function openDrawer() {
    mobileMenu?.classList.remove('hidden');
    menuOverlay?.classList.remove('hidden');
    // Use requestAnimationFrame to defer the transition classes
    requestAnimationFrame(() => {
      mobileMenu?.classList.remove('translate-x-full');
      menuOverlay?.classList.remove('opacity-0');
    });
    document.body.style.overflow = 'hidden';
  }
  
  function closeDrawer() {
    mobileMenu?.classList.add('translate-x-full');
    menuOverlay?.classList.add('opacity-0');
    setTimeout(() => {
      mobileMenu?.classList.add('hidden');
      menuOverlay?.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  menuBtn?.addEventListener('click', openDrawer);
  menuClose?.addEventListener('click', closeDrawer);
  menuOverlay?.addEventListener('click', closeDrawer);

  // Close on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeDrawer);
  });
</script>