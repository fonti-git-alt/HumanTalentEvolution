---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/empresas', label: 'Empresas' },
  { href: '/personas', label: 'Personas' },
  { href: '/metodologia', label: 'Metodología' },
  { href: '/quienes-somos', label: 'Nosotros' },
  { href: '/insights', label: 'Insights' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 glass border-b border-gray-100/50">
  <nav class="container-page">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
          <span class="text-white font-heading font-bold text-lg">HTE</span>
        </div>
        <span class="font-heading font-semibold text-text-dark hidden sm:block group-hover:text-primary transition-colors">
          Human Talent Evolution
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class={`font-medium transition-colors hover:text-primary ${
              currentPath === link.href ? 'text-primary' : 'text-text-medium'
            }`}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA + Mobile Menu -->
      <div class="flex items-center gap-4">
        <a href="/contacto" class="btn btn-primary btn-sm hidden sm:inline-flex">
          Agenda una asesoría
        </a>
        
        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn" 
          class="lg:hidden p-2 text-text-dark hover:text-primary transition-colors"
          aria-label="Abrir menú"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-text-dark/95 z-50 hidden lg:hidden">
    <div class="flex flex-col h-full p-6">
      <div class="flex justify-between items-center mb-8">
        <span class="font-heading font-semibold text-white text-lg">Menú</span>
        <button id="mobile-menu-close" class="p-2 text-white hover:text-primary transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <nav class="flex flex-col gap-6">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class={`text-2xl font-heading font-semibold transition-colors hover:text-primary ${
              currentPath === link.href ? 'text-primary' : 'text-white'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a href="/contacto" class="btn btn-primary btn-lg mt-4">
          Agenda una asesoría
        </a>
        <a 
          href="https://humantalentevolution.psy-tech.net/login" 
          target="_blank"
          rel="noopener"
          class="text-lg text-white/70 hover:text-white transition-colors"
        >
          Registra tu hoja de vida →
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  });

  menuClose?.addEventListener('click', () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
  });

  // Close menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      document.body.style.overflow = '';
    });
  });
</script>
