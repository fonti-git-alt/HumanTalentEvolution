---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import Button from '../components/ui/Button.astro';

const paquetes = [
  {
    id: 'impulso',
    title: 'Impulso Profesional',
    tagline: 'Claridad y enfoque para tu carrera',
    description: 'Ideal si no sabes por dónde empezar.',
    precio: 'Desde $X',
    incluye: [
      'Revisión y ajuste de hoja de vida',
      'Diagnóstico de perfil profesional',
      'Sesión de orientación laboral',
    ],
    cta: 'Solicitar Impulso Profesional',
  },
  {
    id: 'marca',
    title: 'Marca Profesional Estratégica',
    tagline: 'Tu perfil alineado a lo que el mercado busca',
    description: 'Ideal para quienes buscan un cambio laboral.',
    precio: 'Desde $X',
    incluye: [
      'Hoja de vida estratégica',
      'Optimización de perfil LinkedIn',
      'Evaluación psicotécnica',
      'Feedback profesional detallado',
    ],
    cta: 'Solicitar Marca Profesional',
  },
  {
    id: 'salto',
    title: 'Salto Profesional',
    tagline: 'Prepárate para el siguiente nivel',
    description: 'Ideal para quienes están listos para dar un salto profesional importante.',
    precio: 'Desde $X',
    incluye: [
      'Todo lo anterior',
      'Preparación para entrevistas',
      'Construcción de narrativa profesional',
      'Estrategia de búsqueda laboral',
    ],
    cta: 'Solicitar Salto Profesional',
  },
];

const situaciones = [
  {
    titulo: 'Estoy buscando trabajo',
    descripcion: 'Te ayudamos a crear una estrategia de búsqueda efectiva y a posicionarte como el candidato ideal.',
  },
  {
    titulo: 'Quiero crecer laboralmente',
    descripcion: 'Identificamos tus fortalezas y áreas de desarrollo para diseñar tu ruta de crecimiento profesional.',
  },
  {
    titulo: 'Quiero potencializar mi perfil',
    descripcion: 'Optimizamos tu imagen profesional para que destaces frente a reclutadores y empresas.',
  },
];
---

<BaseLayout title="Soluciones para Candidatos" description="Asesoramiento profesional para tu carrera. Te ayudamos a construir una estrategia clara y alcanzar tus objetivos laborales.">
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-16 bg-gradient-to-br from-primary-lighter to-white">
      <div class="container-page">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-dark mb-4">
          Para Candidatos
        </h1>
        <p class="text-xl text-text-medium max-w-2xl">
          Asesoramiento profesional a través de herramientas y orientación personalizada. 
          Te ayudamos a construir una estrategia profesional clara, segura y alineada a tus objetivos.
        </p>
      </div>
    </section>
    
    <!-- Intro -->
    <section class="py-16 bg-white">
      <div class="container-page">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-lg text-text-medium leading-relaxed">
            ¿Por dónde empiezas? ¿Cómo destacas? ¿Qué camino tomar? 
            Мы ayudarte a responder estas preguntas y más, con un acompañamiento personalizado 
            que se adapta a tu situación y tus metas.
          </p>
        </div>
      </div>
    </section>
    
    <!-- Situaciones -->
    <section class="py-16 bg-primary-lighter">
      <div class="container-page">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark text-center mb-12">
          ¿Cuál es tu situación?
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          {situaciones.map((situacion) => (
            <div class="bg-white rounded-2xl p-8 text-center hover:shadow-lg transition-shadow">
              <div class="w-14 h-14 rounded-xl bg-primary flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-heading font-bold text-text-dark mb-3">{situacion.titulo}</h3>
              <p class="text-text-medium">{situacion.descripcion}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Paquetes -->
    <section class="py-16 bg-white">
      <div class="container-page">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark mb-4">
            Conoce nuestros paquetes de acompañamiento
          </h2>
          <p class="text-text-medium max-w-2xl mx-auto">
            Programas diseñados para diferentes etapas de tu desarrollo profesional.
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          {paquetes.map((paquete, index) => (
            <div class={`bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow border-2 ${index === 1 ? 'border-primary' : 'border-transparent'}`}>
              {index === 1 && (
                <span class="inline-block bg-primary text-white text-xs font-semibold px-3 py-1 rounded-full mb-4">
                  Más popular
                </span>
              )}
              <h3 class="text-2xl font-heading font-bold text-text-dark mb-2">{paquete.title}</h3>
              <p class="text-primary font-semibold mb-2">{paquete.tagline}</p>
              <p class="text-text-medium text-sm mb-6">{paquete.description}</p>
              
              <div class="border-t border-gray-100 pt-6 mb-6">
                <h4 class="font-semibold text-text-dark mb-4">Incluye:</h4>
                <ul class="space-y-3">
                  {paquete.incluye.map((item) => (
                    <li class="flex items-start gap-3 text-text-medium text-sm">
                      <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              
              <Button href="/contacto" variant={index === 1 ? 'primary' : 'secondary'} class="w-full">
                {paquete.cta}
              </Button>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- CTA -->
    <section class="py-16 bg-gradient-to-br from-primary to-primary-dark">
      <div class="container-page text-center">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-4">
          ¿Listo para dar el siguiente paso en tu carrera?
        </h2>
        <p class="text-white/80 mb-8 max-w-xl mx-auto">
          Agenda una asesoría gratuita y descubre cómo podemos ayudarte a lograr el trabajo que mereces.
        </p>
        <Button href="/contacto" variant="gold" size="lg">
          Agenda tu asesoría gratuita
        </Button>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />
</BaseLayout>