        rings={4}
      texts={[
        { top: "AQUÍ ESTÁS AHORA", bottom: "AQUÍ TIENES QUE LLEGAR" },
        { top: "Cultura", bottom: "" },
        { top: "Organización", bottom: "Estrategia de Talentos | Diseño Organizacional | Diseño de trabajo | Compensaciones" },
        { top: "Liderazgo", bottom: "Efectividad | Exito" },
        { top: "Personas", bottom: "Reclutar | Desarrollar | Reasignar " }
      ]}

          size={600}
          thickness={60}
        />
</BaseLayout>