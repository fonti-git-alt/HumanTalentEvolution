---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import Button from '../components/ui/Button.astro';

const servicios = [
  {
    id: 'atraccion-seleccion',
    title: 'Atracción y Selección de Talentos',
    tagline: 'Encuentra el talento ideal que tu empresa necesita para crecer.',
    description: 'Atraemos, evaluamos y conectamos a tu organización con candidatos altamente calificados, asegurando un ajuste real entre sus competencias, el perfil del cargo y la cultura de tu empresa.',
    queHacemos: [
      'Búsqueda y evaluación de candidatos para cargos operativos, tácticos y estratégicos',
      'Externalización del proceso de reclutamiento (RPO) integral',
      'Reclutamiento para proyectos o temporadas masivas',
      'Plataforma propia para seguimiento y trazabilidad del proceso',
    ],
    beneficios: [
      'Candidatos cualificados alineados a competencias y cultura organizacional',
      'Visibilidad y confianza en cada etapa del proceso',
      'Experiencia ágil y efectiva para el cliente',
      'Toma de decisiones estratégica basada en datos',
    ],
  },
  {
    id: 'desarrollo-talento',
    title: 'Desarrollo y Valoración del Talento',
    tagline: 'Potencia el desempeño de tu equipo y lleva su talento al siguiente nivel.',
    description: 'Somos aliados estratégicos en el fortalecimiento de habilidades y la transformación cultural de tu organización. Desarrollamos las competencias clave de tu equipo, facilitando la toma de decisiones para impulsar el talento en función de resultados reales.',
    queHacemos: [
      'Diseño de modelo de competencias alineado a cultura y objetivos',
      'Evaluación de desempeño y competencias (90°, 180°, 360°)',
      'Identificación de talento y planes de sucesión',
      'Herramientas digitales para medición y seguimiento ágil',
    ],
    beneficios: [
      'Cierre de brechas de competencias con planes de acción concretos',
      'Retención del talento clave mediante planes de carrera',
      'Decisiones basadas en datos objetivos',
      'Mayor compromiso y desempeño organizacional',
    ],
  },
  {
    id: 'formacion-liderazgo',
    title: 'Formación y Liderazgo',
    tagline: 'Forma líderes que inspiren, guíen y generen resultados.',
    description: 'Impulsa el crecimiento de tu equipo a través de programas de formación diseñados para desarrollar habilidades clave, incorporar nuevas herramientas y fortalecer el liderazgo en todos los niveles de la organización.',
    queHacemos: [
      'Programas de formación y eventos corporativos virtuales y presenciales',
      'Diseño de planes de formación corporativa alineados al negocio',
      'Creación de aulas virtuales y escuelas corporativas a la medida',
      'Metodologías dinámicas y de alto impacto',
    ],
    beneficios: [
      'Desarrollo integral de competencias organizacionales',
      'Cultura de formación continua',
      'Líderes que generan impacto real en sus equipos',
      'Adaptación a los retos actuales del entorno empresarial',
    ],
  },
  {
    id: 'bienestar-cultura',
    title: 'Bienestar y Cultura Organizacional',
    tagline: 'Construye una cultura sólida donde las personas y el negocio prosperen.',
    description: 'Te acompañamos en la creación de entornos laborales positivos, donde el compromiso, la motivación y el sentido de pertenencia impulsan los resultados del negocio.',
    queHacemos: [
      'Medición e intervención de clima laboral completo',
      'Diseño e implementación de programas de cultura y reconocimiento',
      'Actividades de bienestar corporativo y eventos familiares',
      'Estrategias de reconocimiento e incentivos',
    ],
    beneficios: [
      'Entornos laborales positivos y productivos',
      'Mayor compromiso y sentido de pertenencia',
      'Colaboradores felices y motivados',
      'Impacto directo en los resultados organizacionales',
    ],
  },
  {
    id: 'salud-psicosocial',
    title: 'Salud y Gestión de Riesgo Psicosocial',
    tagline: 'Cuida el bienestar emocional de tu equipo y fortalece su productividad.',
    description: 'Acompañamos a tu organización en la gestión integral de la salud mental y los riesgos psicosociales, promoviendo entornos laborales seguros, saludables y sostenibles.',
    queHacemos: [
      'Promoción de la salud mental mediante capacitaciones y talleres',
      'Intervención psicológica para colaboradores (duelo, estrés, ausentismo)',
      'Asesoría en Seguridad y Salud en el Trabajo (SST)',
      'Vigilancia epidemiológica y estrategias de afrontamiento',
    ],
    beneficios: [
      'Prevención de riesgos psicosociales',
      'Entornos laborales seguros y sostenibles',
      'Mayor productividad y mejor clima laboral',
      'Cumplimiento normativo en SST',
    ],
  },
];
---

<BaseLayout title="Soluciones para Empresas" description="Soluciones integrales para la gestión del talento humano. Atracción, desarrollo, formación, bienestar y salud organizacional.">
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-16 bg-gradient-to-br from-primary-lighter to-white">
      <div class="container-page">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-dark mb-4">
          Soluciones para Empresas
        </h1>
        <p class="text-xl text-text-medium max-w-2xl">
          Impulsamos el crecimiento de tu organización a través de soluciones integrales en gestión del talento humano.
        </p>
      </div>
    </section>
    
    <!-- Intro -->
    <section class="py-16 bg-white">
      <div class="container-page">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-lg text-text-medium leading-relaxed">
            En Human Talent Evolution entendemos que el talento es el activo más valioso de cualquier organización. 
            Brindamos soluciones innovadoras que se incorporan al ADN de tu empresa, creando estrategias personalizadas 
            que alinean personas, procesos y cultura.
          </p>
        </div>
      </div>
    </section>
    
    <!-- Servicios -->
    <section class="py-16 bg-gray-50">
      <div class="container-page">
        <div class="space-y-16">
          {servicios.map((servicio, index) => (
            <div id={servicio.id} class="scroll-mt-24 bg-white rounded-2xl p-8 md:p-12 shadow-sm hover:shadow-lg transition-shadow">
              <div class="grid md:grid-cols-2 gap-8">
                <div>
                  <div class="flex items-center gap-3 mb-4">
                    <span class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-heading font-bold text-lg">
                      {index + 1}
                    </span>
                    <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark">
                      {servicio.title}
                    </h2>
                  </div>
                  <p class="text-primary font-semibold mb-2">{servicio.tagline}</p>
                  <p class="text-text-medium text-lg mb-6">
                    {servicio.description}
                  </p>
                  <Button href="/contacto" variant="primary">
                    Solicitar información
                  </Button>
                </div>
                
                <div class="space-y-6">
                  <div>
                    <h3 class="text-lg font-heading font-semibold text-text-dark mb-3 flex items-center gap-2">
                      <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Qué hacemos
                    </h3>
                    <ul class="space-y-2">
                      {servicio.queHacemos.map((item) => (
                        <li class="flex items-start gap-2 text-text-medium">
                          <svg class="w-5 h-5 text-primary/60 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                  
                  <div>
                    <h3 class="text-lg font-heading font-semibold text-text-dark mb-3 flex items-center gap-2">
                      <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                      </svg>
                      Beneficios
                    </h3>
                    <ul class="space-y-2">
                      {servicio.beneficios.map((item) => (
                        <li class="flex items-start gap-2 text-text-medium">
                          <svg class="w-5 h-5 text-accent-gold/60 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- CTA -->
    <section class="py-16 bg-primary-lighter">
      <div class="container-page text-center">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark mb-4">
          ¿Listo para transformar tu gestión del talento?
        </h2>
        <p class="text-text-medium mb-8 max-w-xl mx-auto">
          Contáctanos y descubre cómo podemos ayudarte a construir una organización más fuerte a través de su gente.
        </p>
        <Button href="/contacto" variant="primary" size="lg">
          Agenda una asesoría
        </Button>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />
</BaseLayout>