---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import Button from '../components/ui/Button.astro';
import ConcentricRings from '../components/ConcentricRings.astro';


const servicios = [
  {
    id: 'atraccion-seleccion',
    title: 'Atracción y Selección de Talento',
    shortDescription: 'Encuentra y contrata talento alineado a tu cultura y objetivos.',
    specific: 'Reclutamiento, RPO, procesos masivos',
    tagline: 'Encuentra el talento ideal que tu empresa necesita para crecer.',
    description: 'Atraemos, evaluamos y conectamos a tu organización con candidatos altamente calificados, asegurando un ajuste real entre sus competencias, el perfil del cargo y la cultura de tu empresa.',
    queHacemos: [
      'Búsqueda y evaluación de candidatos para cargos operativos, tácticos y estratégicos',
      'Externalización del proceso de reclutamiento (RPO) integral',
      'Reclutamiento para proyectos o temporadas masivas',
      'Plataforma propia para seguimiento y trazabilidad del proceso',
    ],
    beneficios: [
      'Candidatos cualificados alineados a competencias y cultura organizacional',
      'Visibilidad y confianza en cada etapa del proceso',
      'Experiencia ágil y efectiva para el cliente',
      'Toma de decisiones estratégica basada en datos',
    ],
  },
  {
    id: 'desarrollo-talento',
    title: 'Desarrollo y Valoración del Talento',
    shortDescription: 'Evalúa y potencia el desempeño de tu equipo.',
    specific: 'Evaluaciones 90°/180°/360°, planes de sucesión',
    tagline: 'Potencia el desempeño de tu equipo y lleva su talento al siguiente nivel.',
    description: 'Somos aliados estratégicos en el fortalecimiento de habilidades y la transformación cultural de tu organización. Desarrollamos las competencias clave de tu equipo, facilitando la toma de decisiones para impulsar el talento en función de resultados reales.',
    queHacemos: [
      'Diseño de modelo de competencias alineado a cultura y objetivos',
      'Evaluación de desempeño y competencias (90°, 180°, 360°)',
      'Identificación de talento y planes de sucesión',
      'Herramientas digitales para medición y seguimiento ágil',
    ],
    beneficios: [
      'Cierre de brechas de competencias con planes de acción concretos',
      'Retención del talento clave mediante planes de carrera',
      'Decisiones basadas en datos objetivos',
      'Mayor compromiso y desempeño organizacional',
    ],
  },
  {
    id: 'formacion-liderazgo',
    title: 'Formación y Liderazgo',
    shortDescription: 'Desarrolla líderes que generen resultados.',
    specific: 'Programas, escuelas corporativas, formación a medida',
    tagline: 'Forma líderes que inspiren, guíen y generen resultados.',
    description: 'Impulsa el crecimiento de tu equipo a través de programas de formación diseñados para desarrollar habilidades clave, incorporar nuevas herramientas y fortalecer el liderazgo en todos los niveles de la organización.',
    queHacemos: [
      'Programas de formación y eventos corporativos virtuales y presenciales',
      'Diseño de planes de formación corporativa alineados al negocio',
      'Creación de aulas virtuales y escuelas corporativas a la medida',
      'Metodologías dinámicas y de alto impacto',
    ],
    beneficios: [
      'Desarrollo integral de competencias organizacionales',
      'Cultura de formación continua',
      'Líderes que generan impacto real en sus equipos',
      'Adaptación a los retos actuales del entorno empresarial',
    ],
  },
  {
    id: 'bienestar-cultura',
    title: 'Bienestar y Cultura Organizacional',
    shortDescription: 'Construye entornos donde las personas quieran estar.',
    specific: 'Clima laboral, cultura, reconocimiento',
    tagline: 'Construye una cultura sólida donde las personas y el negocio prosperen.',
    description: 'Te acompañamos en la creación de entornos laborales positivos, donde el compromiso, la motivación y el sentido de pertenencia impulsan los resultados del negocio.',
    queHacemos: [
      'Medición e intervención de clima laboral completo',
      'Diseño e implementación de programas de cultura y reconocimiento',
      'Actividades de bienestar corporativo y eventos familiares',
      'Estrategias de reconocimiento e incentivos',
    ],
    beneficios: [
      'Entornos laborales positivos y productivos',
      'Mayor compromiso y sentido de pertenencia',
      'Colaboradores felices y motivados',
      'Impacto directo en los resultados organizacionales',
    ],
  },
  {
    id: 'salud-psicosocial',
    title: 'Salud y Riesgo Psicosocial',
    shortDescription: 'Protege la salud mental y productividad de tu equipo.',
    specific: 'SST, intervención psicológica, prevención',
    tagline: 'Cuida el bienestar emocional de tu equipo y fortalece su productividad.',
    description: 'Acompañamos a tu organización en la gestión integral de la salud mental y los riesgos psicosociales, promoviendo entornos laborales seguros, saludables y sostenibles.',
    queHacemos: [
      'Promoción de la salud mental mediante capacitaciones y talleres',
      'Intervención psicológica para colaboradores (duelo, estrés, ausentismo)',
      'Asesoría en Seguridad y Salud en el Trabajo (SST)',
      'Vigilancia epidemiológica y estrategias de afrontamiento',
    ],
    beneficios: [
      'Prevención de riesgos psicosociales',
      'Entornos laborales seguros y sostenibles',
      'Mayor productividad y mejor clima laboral',
      'Cumplimiento normativo en SST',
    ],
  },
];
---

<BaseLayout title="Soluciones para Empresas" description="Soluciones integrales para la gestión del talento humano. Atracción, desarrollo, formación, bienestar y salud organizacional.">
  <Header />
  
  <main>
      <!-- Hero Section -->
      <section class="pt-12 md:pt-16 pb-12 md:pb-16 bg-primary-lighter">
        <div class="container-page">
          <div class="grid lg:grid-cols-2 gap-8 md:gap-12 items-center">
            <div class="order-1 lg:order-1">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-text-dark mb-4 leading-tight">
              Soluciones para Empresas
            </h1>
              <p class="text-lg md:text-xl text-text-medium mb-4 md:mb-6 leading-relaxed">
                Impulsamos el crecimiento de tu organización a través de soluciones integrales en gestión del talento humano.
              </p>
              <p class="text-base md:text-lg text-text-medium leading-relaxed mb-6 md:mb-8">
                En Human Talent Evolution entendemos que el talento es el activo más valioso de cualquier organización.
                Brindamos soluciones innovadoras que se incorporan al ADN de tu empresa, creando estrategias personalizadas
                que alinean personas, procesos y cultura.
              </p>
              <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                <Button href="/contacto" variant="primary" class="w-full sm:w-auto">
                  Agenda una asesoría
                </Button>
                <Button href="#atraccion-seleccion" variant="secondary" class="w-full sm:w-auto">
                  Ver soluciones
                </Button>
              </div>
            </div>
            <div class="order-2 lg:order-2 flex justify-center">
              <div class="w-full max-w-[500px] lg:max-w-[550px]">
                <ConcentricRings
                  rings={4}
                  text="LO QUE TE FALTA"
                  texts={[
                    { top: "AQUÍ ESTÁS AHORA", bottom: "AQUÍ TIENES QUE LLEGAR" },
                    { top: "CULTURA", bottom: "" },
                    { top: "ORGANIZACIÓN", bottom: "ESTRATEGIA DE TALENTOS | DISEÑO ORGANIZACIONAL | DISEÑO DE TRABAJO | COMPENSACIONES" },
                    { top: "LIDERAZGO", bottom: "EFECTIVIDAD | EXITO" },
                    { top: "PERSONAS", bottom: "RECLUTAR | DESARROLLAR | REASIGNAR " }
                  ]}
                  size={600}
                  thickness={60}
                  client:load
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Servicios -->
      <section class="py-12 md:py-16 bg-gray-50">
        <div class="container-page">
          <div class="text-center mb-8 md:mb-12">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-text-dark mb-4 leading-tight">
              Nuestras Soluciones
            </h2>
            <p class="text-base md:text-lg text-text-medium max-w-2xl mx-auto leading-relaxed">
              Descubre cómo podemos ayudarte a potenciar el talento de tu organización.
            </p>
          </div>
          <div class="space-y-8">
           {servicios.map((servicio, index) => (
             <div id={servicio.id} class="scroll-mt-24 bg-white rounded-xl md:rounded-2xl p-4 md:p-6 lg:p-8 shadow-sm hover:shadow-lg transition-shadow">
                <div class="grid md:grid-cols-2 gap-4 md:gap-6">
                 <div>
                   <div class="mb-2">
                     <div class="flex items-center gap-3 mb-2">
                       <span class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-heading font-bold text-sm">
                         {index + 1}
                       </span>
                        <h2 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-text-dark leading-tight">
                          {servicio.title}
                        </h2>
                     </div>
                     <p class="text-primary font-semibold mb-1">{servicio.shortDescription}</p>
                     <p class="text-text-medium">👉 {servicio.specific}</p>
                   </div>
                   <div class="extra-left hidden">
                     <p class="text-primary font-semibold mb-1">{servicio.tagline}</p>
                      <p class="text-text-medium text-sm md:text-base mb-4 leading-relaxed">
                        {servicio.description}
                      </p>
                     <Button href="/contacto" variant="primary">
                       Solicitar información
                     </Button>
                   </div>
                 </div>

                 <div>
                   <div class="flex justify-end mb-2">
                     <button onclick="toggleCard(this)" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition-colors">
                       ver más ▼
                     </button>
                   </div>
                   <div class="initial-right">
                   </div>
                   <div class="extra-right hidden">
                     <div class="space-y-4">
                       <div>
                          <h3 class="text-base font-heading font-semibold text-text-dark mb-2 flex items-center gap-2">
                            <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Qué hacemos
                          </h3>
                         <ul class="space-y-2">
                           {servicio.queHacemos.map((item) => (
                             <li class="flex items-start gap-2 text-text-medium">
                               <svg class="w-5 h-5 text-primary/60 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                               </svg>
                               {item}
                             </li>
                           ))}
                         </ul>
                       </div>

                       <div>
                          <h3 class="text-base font-heading font-semibold text-text-dark mb-2 flex items-center gap-2">
                            <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                            Beneficios
                          </h3>
                         <ul class="space-y-2">
                           {servicio.beneficios.map((item) => (
                             <li class="flex items-start gap-2 text-text-medium">
                               <svg class="w-5 h-5 text-accent-gold/60 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                               </svg>
                               {item}
                             </li>
                           ))}
                         </ul>
                       </div>
                     </div>
                   </div>
                 </div>
               </div>
             </div>
           ))}
         </div>
       </div>
     </section>
    
    <!-- CTA -->
    <section class="py-12 md:py-16 bg-primary-lighter">
      <div class="container-page text-center">
        <h2 class="text-xl sm:text-2xl md:text-3xl font-heading font-bold text-text-dark mb-4 leading-tight">
          ¿Listo para transformar tu gestión del talento?
        </h2>
        <p class="text-text-medium mb-6 md:mb-8 max-w-xl mx-auto text-sm md:text-base leading-relaxed">
          Contáctanos y descubre cómo podemos ayudarte a construir una organización más fuerte a través de su gente.
        </p>
        <Button href="/contacto" variant="primary" size="lg">
          Agenda una asesoría
        </Button>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />

  <style>
  :global(.concentric-rings-svg) {
    width: 100% !important;
    height: auto !important;
    max-width: 600px;
  }
</style>

  <script>
    function toggleCard(button: HTMLButtonElement) {
      const card = button.closest('.grid') as HTMLElement;
      if (!card) return;
      const extraLeft = card.querySelector('.extra-left') as HTMLElement;
      const extraRight = card.querySelector('.extra-right') as HTMLElement;
      const initialRight = card.querySelector('.initial-right') as HTMLElement;
      if (!extraLeft || !extraRight || !initialRight) return;
      if (extraLeft.classList.contains('hidden')) {
        extraLeft.classList.remove('hidden');
        extraRight.classList.remove('hidden');
        initialRight.classList.add('hidden');
        button.textContent = 'ver menos ▲';
      } else {
        extraLeft.classList.add('hidden');
        extraRight.classList.add('hidden');
        initialRight.classList.remove('hidden');
        button.textContent = 'ver más ▼';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll<HTMLButtonElement>('button[onclick*="toggleCard"]').forEach(button => {
        button.addEventListener('click', () => {
          toggleCard(button);
        });
        button.removeAttribute('onclick');
      });
    });
  </script>
</BaseLayout>