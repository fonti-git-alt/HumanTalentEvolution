---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import Button from '../components/ui/Button.astro';

const galleryImages = [
  '/images/reduxfotos/galeria/imagen 1.jpeg',
  '/images/reduxfotos/galeria/imagen 2.jpeg',
  '/images/reduxfotos/galeria/imagen 3.jpeg',
  '/images/reduxfotos/galeria/imagen 4.jpeg',
  '/images/reduxfotos/galeria/imagen 5.jpeg',
  '/images/reduxfotos/galeria/imagen 6.jpeg',
  '/images/reduxfotos/galeria/imagen 7.jpeg',
  '/images/reduxfotos/galeria/imagen 8.jpeg',
  '/images/reduxfotos/galeria/imagen 9.jpeg',
  '/images/reduxfotos/galeria/imagen 10.jpeg',
  '/images/reduxfotos/galeria/imagen 11.jpeg',
  '/images/reduxfotos/galeria/imagen 12.jpeg',
  '/images/reduxfotos/galeria/imagen 13.jpeg',
  '/images/reduxfotos/galeria/imagen 14.jpeg',
  '/images/reduxfotos/galeria/imagen 15.jpeg',
  '/images/reduxfotos/galeria/imagen 16.jpeg',
].sort(() => Math.random() - 0.5);

const valoresMetodologia = [
  {
    title: 'Ética',
    description: 'Actuamos con integridad y confidencialidad en cada proceso de valoración.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Confidencialidad',
    description: 'La información de cada valoración se maneja con absoluto cuidado y discreción.',
    icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  },
  {
    title: 'Estrategia',
    description: 'Cada valoración está orientada a generar valor estratégico para personas y organizaciones.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
];
---

<BaseLayout title="Quiénes Somos" description="Conoce a Human Talent Evolution, una consultora especializada en valoración del talento humano con más de 15 años de experiencia.">
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-16 bg-gradient-to-br from-primary-lighter to-white">
      <div class="container-page">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-text-dark mb-4">
            Quiénes Somos
          </h1>
          <p class="text-xl text-text-medium">
            Consultora especializada en valoración del talento humano para tomar decisiones más conscientes y estratégicas.
          </p>
        </div>
      </div>
    </section>
    
    <!-- Historia -->
    <section class="py-24 bg-white">
      <div class="container-page">
        <div class="max-w-4xl mx-auto">
          <div class="grid md:grid-cols-2 gap-16">
            <div>
              <h2 class="text-2xl font-heading font-bold text-text-dark mb-6">Misión</h2>
              <p class="text-text-medium leading-relaxed text-lg">
                Brindamos soluciones innovadoras a las necesidades de nuestros clientes en la gestión del factor humano, atrayendo, desarrollando, evaluando y manteniendo motivado a sus talentos.
              </p>
            </div>
            <div>
              <h2 class="text-2xl font-heading font-bold text-text-dark mb-6">Visión</h2>
              <p class="text-text-medium leading-relaxed text-lg">
                Seremos reconocida como la compañía líder en la transformación y gestión del talento en las organizaciones.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Valores -->
    <section class="py-24 bg-gray-50">
      <div class="container-page">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark text-center mb-16">
          Nuestros Valores
        </h2>
        <div class="grid md:grid-cols-3 gap-10 max-w-4xl mx-auto">
          <div class="bg-white rounded-2xl p-10 text-center">
            <div class="w-16 h-16 rounded-full bg-primary-lighter flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-text-dark mb-4">Servicio Inigualable</h3>
            <p class="text-text-medium text-base">
              Comprendemos a fondo las necesidades y desafíos específicos de nuestros clientes. Sobrepasamos las expectativas ofreciendo soluciones personalizadas y apoyo continuo.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-10 text-center">
            <div class="w-16 h-16 rounded-full bg-primary-lighter flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-text-dark mb-4">Compromiso Apasionado</h3>
            <p class="text-text-medium text-base">
              Con genuina pasión ayudamos a las organizaciones a maximizar el potencial de su talento humano. Nos enfocamos en comprender, apoyar e impulsar su éxito y crecimiento.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-10 text-center">
            <div class="w-16 h-16 rounded-full bg-primary-lighter flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-text-dark mb-4">Actitud Ganadora</h3>
            <p class="text-text-medium text-base">
              Somos positivos, determinados y proactivos hacia el logro de resultados exitosos. Tenemos mentalidad de superación y perseverancia para alcanzar metas ambiciosas.
            </p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Metodología -->
    <section class="py-24 bg-primary-lighter relative">
      <div class="container-page relative z-10">
        <div class="text-center mb-16">
          <h2 class="text-2xl md:text-4xl font-heading font-bold text-text-dark mb-6">
            Nuestra Metodología
          </h2>
          <p class="text-text-medium max-w-2xl mx-auto text-lg">
            Un enfoque disruptivo, experiencial y medible que transforma perspectivas.
          </p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 max-w-7xl mx-auto" id="gallery-grid">
          {galleryImages.slice(0, 16).map((img, index) => (
            <div
              class="relative overflow-hidden rounded-2xl shadow-2xl hover:shadow-purple-500/25 transition-all duration-500 hover:scale-105 hover:rotate-1 group aspect-square gallery-item"
              style={`animation-delay: ${index * 0.1}s`}
              data-index={index}
            >
              <img
                src={img}
                alt={`Imagen ${index + 1}`}
                class={`w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 group-hover:brightness-110`}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <div class="absolute bottom-4 left-4 right-4">
                  <p class="text-white text-sm font-medium">Imagen {index + 1}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Ver más button -->
        <div class="text-center mt-12">
          <button
            id="ver-mas-btn"
            class="bg-accent-gold hover:bg-accent-gold/90 text-white font-semibold py-3 px-8 rounded-full transition-colors duration-300 shadow-lg hover:shadow-xl"
          >
            Ver más
          </button>
        </div>
      </div>
    </section>

    <script>
      let showingMore = false;
      const verMasBtn = document.getElementById('ver-mas-btn') as HTMLButtonElement | null;
      const galleryItems = document.querySelectorAll('.gallery-item') as NodeListOf<HTMLElement>;

      function getInitialCount() {
        const width = window.innerWidth;
        if (width < 768) return 4; // 2 columns × 2 rows on mobile
        if (width < 1024) return 6; // 3 columns × 2 rows on tablet
        return 8; // 4 columns × 2 rows on desktop
      }

      function updateVisibleImages() {
        if (!verMasBtn) return;
        const initialCount = getInitialCount();

        galleryItems.forEach((item, index) => {
          if (showingMore || index < initialCount) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });

        verMasBtn.textContent = showingMore ? 'Ver menos' : 'Ver más';
        verMasBtn.style.display = galleryItems.length <= initialCount ? 'none' : 'inline-block';
      }

      verMasBtn?.addEventListener('click', () => {
        showingMore = !showingMore;
        updateVisibleImages();
      });

      // Initial setup and responsive handling
      window.addEventListener('resize', updateVisibleImages);
      updateVisibleImages();
    </script>

    <!-- Valores metodológicos -->
    <section class="py-16 bg-white">
      <div class="container-page">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark text-center mb-4">
            Nuestros Compromisos
          </h2>
          <p class="text-text-medium text-center mb-12 max-w-2xl mx-auto">
            Actuamos bajo principios que garantizan la calidad y ética de cada proceso de valoración.
          </p>
          <div class="grid md:grid-cols-3 gap-8">
            {valoresMetodologia.map((valor) => (
              <div class="text-center p-6">
                <div class="w-16 h-16 rounded-full bg-primary-lighter flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={valor.icon} />
                  </svg>
                </div>
                <h3 class="text-xl font-heading font-bold text-text-dark mb-2">{valor.title}</h3>
                <p class="text-text-medium">{valor.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
    
    <!-- Diferenciador -->
    <section class="py-16 bg-gradient-to-br from-primary to-primary-dark">
      <div class="container-page">
        <div class="max-w-3xl mx-auto text-center text-white">
          <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">
            ¿Por qué nuestra metodología funciona?
          </h2>
          <p class="text-white/80 mb-8 text-lg">
            Combinamos rigor científico con pragmatismo empresarial. No solo te decimos qué descubrió 
            la valoración, sino qué puedes hacer al respecto. Cada insight viene acompañado de 
            recomendaciones prácticas y accionables.
          </p>
          <Button href="/contacto" variant="gold" size="lg">
            Agenda una asesoría
          </Button>
        </div>
      </div>
    </section>
    
    <!-- Valores -->
    <section class="py-16 bg-gray-50">
      <div class="container-page">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark text-center mb-12">
          Lo que nos define
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
            <div class="w-14 h-14 rounded-xl bg-primary-lighter flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="font-heading font-semibold text-text-dark mb-2">Enfoque Humano</h3>
            <p class="text-text-medium text-sm">
              Las personas son el centro de todo lo que hacemos.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
            <div class="w-14 h-14 rounded-xl bg-primary-lighter flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-heading font-semibold text-text-dark mb-2">Rigor Profesional</h3>
            <p class="text-text-medium text-sm">
              Metodologías validadas y evidencia científica.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
            <div class="w-14 h-14 rounded-xl bg-primary-lighter flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-heading font-semibold text-text-dark mb-2">Orientación a Resultados</h3>
            <p class="text-text-medium text-sm">
              Insights accionables que generan impacto real.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
            <div class="w-14 h-14 rounded-xl bg-primary-lighter flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
              </svg>
            </div>
            <h3 class="font-heading font-semibold text-text-dark mb-2">Cercanía</h3>
            <p class="text-text-medium text-sm">
              Relación cercana y personalizada con cada cliente.
            </p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Equipo Directivo -->
    <section class="py-20 bg-white">
      <div class="container-page">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-16">
            <span class="text-primary font-semibold text-sm uppercase tracking-wider">Equipo Profesional</span>
            <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark mt-3">
              Profesionales altamente calificados
            </h2>
          </div>
          
          <div class="mb-16">
            <div class="bg-white rounded-2xl p-8 shadow-lg max-w-5xl mx-auto hover:shadow-xl transition-shadow duration-300">
              <div class="grid md:grid-cols-2 gap-8 items-center">
                <img
                  src="/images/reduxfotos/Quienes somos/NUESTRO_EQUIPO.jpg"
                  alt="Nuestro equipo de psicólogos"
                  class="w-full aspect-[4/3] object-cover object-[35%_40%] rounded-xl transition-transform duration-300 hover:translate-y-[-10px]"
                />
                <div>
                  <p class="text-lg text-text-medium leading-relaxed mb-6 hover:text-primary transition-colors duration-300 text-center">
                    Nuestro equipo de psicólogos organizacionales seniors, certificados con experiencia en gestión de recursos humanos.<br>
                    <strong>Te brindamos atención personalizada y acompañamiento permanente.</strong>
                  </p>
                  <div class="text-center">
                    <Button href="/contacto" variant="primary" size="lg">
                      Agenda una asesoría
                    </Button>
                  </div>
                </div>
              </div>
            </div>

          <!-- Video embebido -->
          <div class="bg-gray-50 rounded-2xl p-8 text-center mt-8">
            <div class="max-w-4xl mx-auto">
              <h3 class="text-xl font-heading font-bold text-text-dark mb-6">Conoce nuestro equipo</h3>
              <p class="text-text-medium mb-8">
                Descubre más sobre nosotros y nuestra filosofía de trabajo.
              </p>
              <div class="relative w-full max-w-2xl mx-auto aspect-video rounded-xl overflow-hidden shadow-2xl">
                <iframe
                  src="https://www.youtube.com/embed/NbUEYviI4YY?rel=0&modestbranding=1&iv_load_policy=3&fs=0&disablekb=1&cc_load_policy=0"
                  title="Conoce nuestro equipo - Human Talent Evolution"
                  class="absolute inset-0 w-full h-full"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- CTA -->
    <section class="py-16 bg-primary-lighter">
      <div class="container-page text-center">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-text-dark mb-4">
          ¿Conoces el talento de tu organización?
        </h2>
        <p class="text-text-medium mb-8 max-w-xl mx-auto">
          Hablemos sobre cómo podemos ayudarte a valorar, desarrollar y potenciar a tu gente.
        </p>
        <Button href="/contacto" variant="primary" size="lg">
          Agenda una asesoría
        </Button>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />
</BaseLayout>
