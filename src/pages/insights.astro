---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import Button from '../components/ui/Button.astro';

const articulos = [
  {
    title: 'Cómo identificar el talento clave en tu organización',
    fecha: '15 de marzo, 2026',
    descripcion: 'Guía práctica para reconocer y desarrollar a las personas que marcarán la diferencia en tu empresa.',
  },
  {
    title: 'El arte de dar retroalimentación efectiva',
    fecha: '1 de marzo, 2026',
    descripcion: 'Por qué la forma en que comunicamos影响了 directamente el desarrollo de nuestro equipo.',
  },
  {
    title: 'Sucesión: preparando el futuro de tu organización',
    fecha: '15 de febrero, 2026',
    descripcion: 'Estrategias para crear un pipeline de talento que garantice la continuidad del negocio.',
  },
];
---

<BaseLayout title="Insights" description="Contenido educativo sobre talento, liderazgo y gestión de personas. Artículos, guías y perspectivas de Human Talent Evolution.">
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="pt-20 md:pt-24 lg:pt-32 pb-12 md:pb-16 bg-gradient-to-br from-primary-lighter to-white">
      <div class="container-page">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-text-dark mb-4 leading-tight">
          Insights
        </h1>
        <p class="text-lg md:text-xl text-text-medium max-w-2xl leading-relaxed">
          Contenido educativo sobre talento, liderazgo y gestión de personas.
        </p>
      </div>
    </section>
    
    <!-- Coming Soon Message -->
    <section class="py-12 md:py-16 bg-white">
      <div class="container-page">
        <div class="max-w-2xl mx-auto text-center">
          <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-primary-lighter flex items-center justify-center mx-auto mb-4 md:mb-6">
            <svg class="w-8 h-8 md:w-10 md:h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-dark mb-3 md:mb-4 leading-tight">
            Próximamente
          </h2>
          <p class="text-text-medium">
            Estamos preparando contenido valioso sobre valoración del talento, liderazgo y gestión de personas. 
            Muy pronto podrás encontrar artículos, guías y perspectivas que te ayudarán a desarrollar 
            mejores prácticas en tu organización.
          </p>
        </div>
      </div>
    </section>
    
    <!-- Placeholder Articles -->
    <section class="py-12 md:py-16 bg-gray-50">
      <div class="container-page">
        <h2 class="text-lg sm:text-xl font-heading font-semibold text-text-dark mb-6 md:mb-8 leading-tight">
          Artículos recientes
        </h2>
        <div class="space-y-4 md:space-y-6">
          {articulos.map((articulo) => (
            <a href="#" class="block bg-white rounded-xl md:rounded-2xl p-4 md:p-6 shadow-sm hover:shadow-md hover:border-primary/20 transition-all group">
              <div class="flex flex-col md:flex-row md:items-center gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <span class="text-sm text-primary font-semibold">{articulo.fecha}</span>
                  </div>
                  <h3 class="text-lg font-heading font-semibold text-text-dark group-hover:text-primary transition-colors">
                    {articulo.title}
                  </h3>
                  <p class="text-text-medium text-sm mt-2">
                    {articulo.descripcion}
                  </p>
                </div>
                <div class="shrink-0">
                  <span class="inline-flex items-center text-primary font-semibold group-hover:gap-2 transition-all">
                    Leer más
                    <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Subscribe CTA -->
    <section class="py-12 md:py-16 bg-gradient-to-br from-primary to-primary-dark">
      <div class="container-page">
        <div class="max-w-2xl mx-auto text-center text-white">
          <h2 class="text-xl sm:text-2xl md:text-3xl font-heading font-bold mb-3 md:mb-4 leading-tight">
            Mantente informado
          </h2>
          <p class="text-white/80 mb-6 md:mb-8 text-sm md:text-base leading-relaxed">
            Cuando lancemos nuevos contenidos, queremos que seas el primero en enterarte.
            Suscríbete para recibir actualizaciones.
          </p>
          <Button href="/contacto" variant="gold" size="lg">
            Quiero estar al día
          </Button>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />
</BaseLayout>
